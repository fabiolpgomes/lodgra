<mjml>
  <mj-head>
    <mj-title>{{subject}}</mj-title>
    <mj-preview>{{copy.previewText}} - {{propertyName}}</mj-preview>
    <!-- Standard template version: {{templateVersion}} -->
    <mj-style>
      .button-text { color: #ffffff; text-decoration: none; }
      .header-text { color: {{primaryColor}}; font-weight: bold; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <!-- Header with logo -->
    <mj-section background-color="#ffffff" padding="20px 0">
      <mj-column>
        {{#if logoUrl}}
        <mj-image src="{{logoUrl}}" alt="{{organizationName}}" width="120px" />
        {{/if}}
        <mj-text align="center" font-size="28px" font-weight="bold" color="{{primaryColor}}">
          {{organizationName}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Main content -->
    <mj-section background-color="#ffffff" padding="30px 20px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#1f2937">
          {{subject}}
        </mj-text>

        <mj-text color="#6b7280" padding-top="20px">
          {{copy.greeting}} {{customerName}},
        </mj-text>

        <mj-text color="#6b7280" line-height="1.6">
          {{copy.intro}}
        </mj-text>

        <!-- Custom message (if provided) -->
        {{#if confirmationMessage}}
        <mj-text color="#6b7280" line-height="1.6" padding="20px 0">
          {{confirmationMessage}}
        </mj-text>
        {{/if}}

        <!-- Booking details -->
        <mj-table padding="20px 0">
          {{#if reservationNumber}}
          <tr style="border-bottom: 1px solid #e5e7eb;">
            <td style="padding: 10px 0; font-weight: bold; color: #1f2937;">{{copy.reservationLabel}}</td>
            <td style="padding: 10px 0; color: #6b7280;">{{reservationNumber}}</td>
          </tr>
          {{/if}}
          {{#if nights}}
          <tr style="border-bottom: 1px solid #e5e7eb;">
            <td style="padding: 10px 0; font-weight: bold; color: #1f2937;">{{copy.nightsLabel}}</td>
            <td style="padding: 10px 0; color: #6b7280;">{{nights}}</td>
          </tr>
          {{/if}}
          <tr style="border-bottom: 1px solid #e5e7eb;">
            <td style="padding: 10px 0; font-weight: bold; color: #1f2937;">{{copy.propertyLabel}}</td>
            <td style="padding: 10px 0; color: #6b7280;">{{propertyName}}</td>
          </tr>
          <tr style="border-bottom: 1px solid #e5e7eb;">
            <td style="padding: 10px 0; font-weight: bold; color: #1f2937;">{{copy.guestsLabel}}</td>
            <td style="padding: 10px 0; color: #6b7280;">{{guestCount}}</td>
          </tr>
          <tr style="border-bottom: 1px solid #e5e7eb;">
            <td style="padding: 10px 0; font-weight: bold; color: #1f2937;">{{copy.checkInLabel}}</td>
            <td style="padding: 10px 0; color: #6b7280;">{{checkInDate}}</td>
          </tr>
          <tr style="border-bottom: 1px solid #e5e7eb;">
            <td style="padding: 10px 0; font-weight: bold; color: #1f2937;">{{copy.checkOutLabel}}</td>
            <td style="padding: 10px 0; color: #6b7280;">{{checkOutDate}}</td>
          </tr>
          <tr>
            <td style="padding: 10px 0; font-weight: bold; color: #1f2937;">{{copy.totalPriceLabel}}</td>
            <td style="padding: 10px 0; color: #1f2937; font-weight: bold; font-size: 18px;">{{currency}} {{totalPrice}}</td>
          </tr>
        </mj-table>

        <!-- CTA Button -->
        <mj-button
          padding="20px 0"
          background-color="{{primaryColor}}"
          href="{{bookingUrl}}"
          font-size="16px"
          border-radius="4px">
          {{copy.ctaLabel}}
        </mj-button>

        <mj-text color="#6b7280" padding-top="20px">
          {{copy.supportText}} {{replyToEmail}}.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f9fafb" padding="20px">
      <mj-column>
        {{#if footerText}}
        <mj-text font-size="13px" color="#6b7280" align="center">
          {{footerText}}
        </mj-text>
        {{/if}}

        <mj-text font-size="12px" color="#9ca3af" align="center" padding-top="10px">
          © {{year}} {{organizationName}}. {{copy.rightsText}}
        </mj-text>

        <mj-text font-size="12px" color="#9ca3af" align="center" padding-top="10px">
          <a href="{{unsubscribeUrl}}" style="color: #9ca3af; text-decoration: underline;">{{copy.unsubscribeText}}</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
