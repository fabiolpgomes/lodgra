{
  "$schema": "https://tokens.studio/json-schema/draft-2024-09.json",
  "metadata": {
    "version": "2.0.0",
    "created": "2026-04-18",
    "updated": "2026-09-29",
    "brand": "Lodgra",
    "status": "production",
    "source": "docs/design-system/design.md (Lodgra Premium) — fonte única da verdade. Não editar cores aqui sem alterar o design.md.",
    "compliance": "WCAG AA"
  },
  "colors": {
    "primary": {
      "default": {
        "$value": "#10203E",
        "$type": "color",
        "description": "Azul institucional — CTAs principais, links, títulos, navegação, gradientes de gráficos"
      },
      "active": {
        "$value": "#0C1830",
        "$type": "color",
        "description": "Azul pressionado — estados active, overlays"
      },
      "disabled": {
        "$value": "rgba(16,32,62,0.28)",
        "$type": "color",
        "description": "CTAs desativados"
      }
    },
    "accent": {
      "luxe": {
        "$value": "#C9A227",
        "$type": "color",
        "description": "Dourado — badges de métricas, avisos, avaliações, toggles, notificações ativas"
      },
      "plus": {
        "$value": "#B08B1F",
        "$type": "color",
        "description": "Dourado pressionado — detalhes de alta ênfase"
      }
    },
    "success": {
      "default": {
        "$value": "#00674F",
        "$type": "color",
        "description": "Verde esmeralda — sucesso, crescimento, confirmações"
      },
      "light": {
        "$value": "#0A8B6F",
        "$type": "color",
        "description": "Esmeralda claro — hover e indicadores secundários"
      }
    },
    "error": {
      "text": {
        "$value": "#9F2F1F",
        "$type": "color",
        "description": "Texto de erro"
      },
      "text-hover": {
        "$value": "#7F2115",
        "$type": "color",
        "description": "Texto de erro — hover"
      }
    },
    "text": {
      "ink": {
        "$value": "#1B2430",
        "$type": "color",
        "description": "Texto principal e títulos"
      },
      "body": {
        "$value": "#4D5566",
        "$type": "color",
        "description": "Texto de corpo / secundário"
      },
      "muted": {
        "$value": "rgba(16,32,62,0.62)",
        "$type": "color",
        "description": "Texto atenuado"
      },
      "muted-soft": {
        "$value": "#7C8492",
        "$type": "color",
        "description": "Texto atenuado suave, placeholders"
      },
      "on-primary": {
        "$value": "#FFFFFF",
        "$type": "color",
        "description": "Texto sobre azul institucional"
      }
    },
    "surface": {
      "page": {
        "$value": "#F7F5EF",
        "$type": "color",
        "description": "Fundo global da página (areia)"
      },
      "canvas": {
        "$value": "#FBFAF6",
        "$type": "color",
        "description": "Cards, sidebar, modais, campos de formulário"
      },
      "strong": {
        "$value": "#EEE7D8",
        "$type": "color",
        "description": "Superfícies de maior destaque, botões de ícone"
      },
      "scrim": {
        "$value": "rgba(12,24,48,0.9)",
        "$type": "color",
        "description": "Overlay de modal"
      }
    },
    "border": {
      "hairline": {
        "$value": "#E5DFD2",
        "$type": "color",
        "description": "Borda padrão"
      },
      "hairline-soft": {
        "$value": "#EFEADF",
        "$type": "color",
        "description": "Divisores suaves"
      },
      "strong": {
        "$value": "#CFC4AA",
        "$type": "color",
        "description": "Borda de ênfase"
      }
    },
    "semantic": {
      "success": {
        "$value": "{colors.success.default}",
        "$type": "color"
      },
      "warning": {
        "$value": "{colors.accent.luxe}",
        "$type": "color"
      },
      "error": {
        "$value": "{colors.error.text}",
        "$type": "color"
      },
      "info": {
        "$value": "{colors.primary.default}",
        "$type": "color"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "base": {
        "$value": "'Airbnb Cereal VF', Circular, -apple-system, system-ui, Roboto, 'Helvetica Neue', sans-serif",
        "$type": "fontFamily",
        "description": "Família única do sistema (design.md)"
      }
    },
    "textStyle": {
      "display-xl": {
        "$type": "typography",
        "fontFamily": "{typography.fontFamily.base}",
        "fontSize": "28px",
        "fontWeight": "700",
        "lineHeight": "1.43",
        "letterSpacing": "0px"
      },
      "display-lg": {
        "$type": "typography",
        "fontFamily": "{typography.fontFamily.base}",
        "fontSize": "22px",
        "fontWeight": "500",
        "lineHeight": "1.18",
        "letterSpacing": "-0.44px"
      },
      "display-md": {
        "$type": "typography",
        "fontFamily": "{typography.fontFamily.base}",
        "fontSize": "21px",
        "fontWeight": "700",
        "lineHeight": "1.43",
        "letterSpacing": "0px"
      },
      "display-sm": {
        "$type": "typography",
        "fontFamily": "{typography.fontFamily.base}",
        "fontSize": "20px",
        "fontWeight": "600",
        "lineHeight": "1.2",
        "letterSpacing": "-0.18px"
      },
      "title-md": {
        "$type": "typography",
        "fontFamily": "{typography.fontFamily.base}",
        "fontSize": "16px",
        "fontWeight": "600",
        "lineHeight": "1.25",
        "letterSpacing": "0px"
      },
      "title-sm": {
        "$type": "typography",
        "fontFamily": "{typography.fontFamily.base}",
        "fontSize": "16px",
        "fontWeight": "500",
        "lineHeight": "1.25",
        "letterSpacing": "0px"
      },
      "rating-display": {
        "$type": "typography",
        "fontFamily": "{typography.fontFamily.base}",
        "fontSize": "64px",
        "fontWeight": "700",
        "lineHeight": "1.1",
        "letterSpacing": "-1px"
      },
      "body-md": {
        "$type": "typography",
        "fontFamily": "{typography.fontFamily.base}",
        "fontSize": "16px",
        "fontWeight": "400",
        "lineHeight": "1.5",
        "letterSpacing": "0px"
      },
      "body-sm": {
        "$type": "typography",
        "fontFamily": "{typography.fontFamily.base}",
        "fontSize": "14px",
        "fontWeight": "400",
        "lineHeight": "1.43",
        "letterSpacing": "0px"
      },
      "caption": {
        "$type": "typography",
        "fontFamily": "{typography.fontFamily.base}",
        "fontSize": "14px",
        "fontWeight": "500",
        "lineHeight": "1.29",
        "letterSpacing": "0px"
      },
      "caption-sm": {
        "$type": "typography",
        "fontFamily": "{typography.fontFamily.base}",
        "fontSize": "13px",
        "fontWeight": "400",
        "lineHeight": "1.23",
        "letterSpacing": "0px"
      },
      "badge": {
        "$type": "typography",
        "fontFamily": "{typography.fontFamily.base}",
        "fontSize": "11px",
        "fontWeight": "600",
        "lineHeight": "1.18",
        "letterSpacing": "0px"
      },
      "micro-label": {
        "$type": "typography",
        "fontFamily": "{typography.fontFamily.base}",
        "fontSize": "12px",
        "fontWeight": "700",
        "lineHeight": "1.33",
        "letterSpacing": "0px"
      },
      "button-md": {
        "$type": "typography",
        "fontFamily": "{typography.fontFamily.base}",
        "fontSize": "16px",
        "fontWeight": "500",
        "lineHeight": "1.25",
        "letterSpacing": "0px"
      },
      "button-sm": {
        "$type": "typography",
        "fontFamily": "{typography.fontFamily.base}",
        "fontSize": "14px",
        "fontWeight": "500",
        "lineHeight": "1.29",
        "letterSpacing": "0px"
      },
      "link": {
        "$type": "typography",
        "fontFamily": "{typography.fontFamily.base}",
        "fontSize": "14px",
        "fontWeight": "400",
        "lineHeight": "1.43",
        "letterSpacing": "0px"
      },
      "nav-link": {
        "$type": "typography",
        "fontFamily": "{typography.fontFamily.base}",
        "fontSize": "16px",
        "fontWeight": "600",
        "lineHeight": "1.25",
        "letterSpacing": "0px"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xxs": {
      "$value": "2px"
    },
    "xs": {
      "$value": "4px"
    },
    "sm": {
      "$value": "8px"
    },
    "md": {
      "$value": "12px"
    },
    "base": {
      "$value": "16px"
    },
    "lg": {
      "$value": "24px"
    },
    "xl": {
      "$value": "32px"
    },
    "xxl": {
      "$value": "48px"
    },
    "section": {
      "$value": "64px"
    }
  },
  "borderRadius": {
    "$type": "dimension",
    "none": {
      "$value": "0px"
    },
    "xs": {
      "$value": "4px"
    },
    "sm": {
      "$value": "8px",
      "description": "Botões, inputs"
    },
    "md": {
      "$value": "14px",
      "description": "Cards"
    },
    "lg": {
      "$value": "20px"
    },
    "xl": {
      "$value": "32px"
    },
    "full": {
      "$value": "9999px",
      "description": "Pílulas, círculos"
    }
  },
  "shadow": {
    "float": {
      "$value": "rgba(0,0,0,0.02) 0 0 0 1px, rgba(0,0,0,0.04) 0 2px 6px 0, rgba(0,0,0,0.1) 0 4px 8px 0",
      "$type": "shadow",
      "description": "Única sombra do sistema — hover de cards, dropdowns, barra de busca. Demais superfícies são flat."
    }
  },
  "components": {
    "button": {
      "primary": {
        "background": {
          "$value": "{colors.primary.default}",
          "$type": "color"
        },
        "color": {
          "$value": "{colors.text.on-primary}",
          "$type": "color"
        },
        "typography": "{typography.textStyle.button-md}",
        "borderRadius": {
          "$value": "{borderRadius.sm}",
          "$type": "dimension"
        },
        "padding": {
          "$value": "14px 24px",
          "$type": "dimension"
        },
        "height": {
          "$value": "48px",
          "$type": "dimension"
        },
        "active": {
          "background": {
            "$value": "{colors.primary.active}",
            "$type": "color"
          }
        },
        "disabled": {
          "background": {
            "$value": "{colors.primary.disabled}",
            "$type": "color"
          }
        }
      },
      "secondary": {
        "background": {
          "$value": "{colors.surface.canvas}",
          "$type": "color"
        },
        "color": {
          "$value": "{colors.text.ink}",
          "$type": "color"
        },
        "border": {
          "$value": "1px solid {colors.border.hairline}",
          "$type": "stroke"
        },
        "typography": "{typography.textStyle.button-md}",
        "borderRadius": {
          "$value": "{borderRadius.sm}",
          "$type": "dimension"
        },
        "padding": {
          "$value": "13px 23px",
          "$type": "dimension"
        },
        "height": {
          "$value": "48px",
          "$type": "dimension"
        }
      },
      "tertiary": {
        "background": {
          "$value": "transparent",
          "$type": "color"
        },
        "color": {
          "$value": "{colors.primary.default}",
          "$type": "color"
        },
        "typography": "{typography.textStyle.button-md}"
      },
      "success": {
        "background": {
          "$value": "{colors.success.default}",
          "$type": "color"
        },
        "color": {
          "$value": "{colors.text.on-primary}",
          "$type": "color"
        },
        "hover": {
          "background": {
            "$value": "{colors.success.light}",
            "$type": "color"
          }
        }
      },
      "pill": {
        "background": {
          "$value": "{colors.primary.default}",
          "$type": "color"
        },
        "color": {
          "$value": "{colors.text.on-primary}",
          "$type": "color"
        },
        "typography": "{typography.textStyle.button-sm}",
        "borderRadius": {
          "$value": "{borderRadius.full}",
          "$type": "dimension"
        },
        "padding": {
          "$value": "10px 20px",
          "$type": "dimension"
        }
      }
    },
    "card": {
      "background": {
        "$value": "{colors.surface.canvas}",
        "$type": "color"
      },
      "border": {
        "$value": "1px solid {colors.border.hairline}",
        "$type": "stroke"
      },
      "borderRadius": {
        "$value": "{borderRadius.md}",
        "$type": "dimension"
      },
      "padding": {
        "$value": "{spacing.lg}",
        "$type": "dimension"
      },
      "hover": {
        "shadow": {
          "$value": "{shadow.float}",
          "$type": "shadow"
        }
      }
    },
    "input": {
      "background": {
        "$value": "{colors.surface.canvas}",
        "$type": "color"
      },
      "border": {
        "$value": "1px solid {colors.border.hairline}",
        "$type": "stroke"
      },
      "borderRadius": {
        "$value": "{borderRadius.sm}",
        "$type": "dimension"
      },
      "color": {
        "$value": "{colors.text.ink}",
        "$type": "color"
      },
      "placeholder": {
        "$value": "{colors.text.muted-soft}",
        "$type": "color"
      },
      "focus": {
        "borderColor": {
          "$value": "{colors.primary.default}",
          "$type": "color"
        }
      }
    },
    "topNav": {
      "background": {
        "$value": "{colors.surface.canvas}",
        "$type": "color"
      },
      "color": {
        "$value": "{colors.text.ink}",
        "$type": "color"
      },
      "typography": "{typography.textStyle.nav-link}",
      "height": {
        "$value": "80px",
        "$type": "dimension"
      }
    }
  },
  "accessibility": {
    "contrastRatios": {
      "white_on_primary": {
        "$value": "16.2:1",
        "level": "AAA"
      },
      "ink_on_page": {
        "$value": "14.4:1",
        "level": "AAA"
      },
      "body_on_canvas": {
        "$value": "7.2:1",
        "level": "AAA"
      },
      "primary_on_canvas": {
        "$value": "15.5:1",
        "level": "AAA"
      },
      "white_on_success": {
        "$value": "6.9:1",
        "level": "AA"
      },
      "gold_on_primary": {
        "$value": "6.7:1",
        "level": "AA"
      },
      "gold_on_canvas": {
        "$value": "2.3:1",
        "level": "FAIL",
        "note": "Dourado não deve ser usado para texto sobre fundo claro — só em badges/ícones/elementos decorativos"
      },
      "muted_soft_on_canvas": {
        "$value": "3.6:1",
        "level": "AA (texto grande)"
      }
    },
    "touchTarget": {
      "minimum": {
        "$value": "44px",
        "description": "Alvo mínimo de toque (WCAG mobile)"
      }
    }
  }
}